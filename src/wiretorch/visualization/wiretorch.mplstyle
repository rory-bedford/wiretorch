# Project-wide matplotlib style for wiretorch analysis notebooks.
# Usage: from wiretorch.visualization import use_project_style; use_project_style()

figure.dpi: 120
figure.figsize: 10, 6

font.size: 10
axes.titlesize: 11
axes.labelsize: 10
xtick.labelsize: 9
ytick.labelsize: 9
legend.fontsize: 9
figure.titlesize: 12
